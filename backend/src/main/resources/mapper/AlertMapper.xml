<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.battery.platform.mapper.AlertMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.battery.platform.entity.Alert">
        <id column="id" property="id"/>
        <result column="alert_no" property="alertNo"/>
        <result column="vehicle_id" property="vehicleId"/>
        <result column="vin" property="vin"/>
        <result column="alert_type" property="alertType"/>
        <result column="alert_level" property="alertLevel"/>
        <result column="description" property="description"/>
        <result column="status" property="status"/>
        <result column="handler" property="handler"/>
        <result column="handle_time" property="handleTime"/>
        <result column="handle_remark" property="handleRemark"/>
        <result column="work_order_id" property="workOrderId"/>
        <result column="alert_time" property="alertTime"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, alert_no, vehicle_id, vin, alert_type, alert_level, description,
        status, handler, handle_time, handle_remark, work_order_id,
        alert_time, create_time, update_time, deleted
    </sql>

</mapper>
