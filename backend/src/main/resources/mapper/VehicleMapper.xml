<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.battery.platform.mapper.VehicleMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.battery.platform.entity.Vehicle">
        <id column="id" property="id"/>
        <result column="vin" property="vin"/>
        <result column="plate_number" property="plateNumber"/>
        <result column="model" property="model"/>
        <result column="battery_code" property="batteryCode"/>
        <result column="status" property="status"/>
        <result column="soc" property="soc"/>
        <result column="soh" property="soh"/>
        <result column="temperature" property="temperature"/>
        <result column="longitude" property="longitude"/>
        <result column="latitude" property="latitude"/>
        <result column="risk_level" property="riskLevel"/>
        <result column="total_mileage" property="totalMileage"/>
        <result column="operator" property="operator"/>
        <result column="last_report_time" property="lastReportTime"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, vin, plate_number, model, battery_code, status, soc, soh, temperature,
        longitude, latitude, risk_level, total_mileage, operator, last_report_time,
        create_time, update_time, deleted
    </sql>

</mapper>
